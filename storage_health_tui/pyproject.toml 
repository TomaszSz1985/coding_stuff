project]
name = "storage-health-tui"
version = "0.1.0"
description = "Terminal UI for monitoring disk health"
requires-python = ">=3.11"
dependencies = [
    "textual>=0.61",
    "rich>=13.0",
]

[project.scripts]
storage-health-tui = "storage_health_tui.main:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"